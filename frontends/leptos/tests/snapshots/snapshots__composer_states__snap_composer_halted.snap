<section data-testid="leptos-composer" data-turn-state="halted" class="leptos-composer"><button data-testid="leptos-composer-sessions" data-panel-open="false" class="leptos-composer-sessions">Sessions</button><div class="panels-menu-wrap" style="position:relative;display:inline-flex;;"><button data-testid="panels-menu-btn" data-activity="false" class="leptos-composer-panels"><!><!--<() />-->Panels</button><!><!--<() />--></div><select data-testid="leptos-composer-model" class="leptos-composer-model"><option value="claude-sonnet-4-6">Sonnet</option><option value="claude-opus-4-8">Opus</option><!></select><select data-testid="leptos-composer-effort" class="leptos-composer-effort"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option><option value="max">Max</option><!></select><button data-testid="leptos-composer-prompt" title="Open prompt panel — also opens the editor (Prompt)" class="leptos-composer-prompt"><!><!--<() />-->Prompt</button><!><!--<() />--><button data-testid="leptos-composer-abort" class="leptos-composer-abort">■</button><button data-testid="leptos-composer-resume" class="leptos-composer-resume">▶</button><div data-testid="leptos-status-chip" data-status="offline" class="status-chip">Offline</div></section>
